{
  "manifest_version": 3,
  "name": "划词翻译",
  "version": "0.3.0",
  "description": "选中网页文字即可翻译。支持 DeepSeek 与 Google 两种引擎。",
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "划词翻译",
    "default_popup": "popup.html"
  }
}
